with "config/zephyrine_host_config.gpr";
project Zephyrine_Host is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Zephyrine_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("zephyrine_host.adb");

   package Compiler is
      -- Using a robust set of switches for maximum compatibility
      -- -gnatA: Ignores global configuration files (gnat.adc)
      -- -gnatf: Provides full error messages
      -- -gnatQ: Keeps going on errors to catch as many as possible
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnatW8", "-gnatf", "-gnatQ", "-gnatA");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Zephyrine_Host;
