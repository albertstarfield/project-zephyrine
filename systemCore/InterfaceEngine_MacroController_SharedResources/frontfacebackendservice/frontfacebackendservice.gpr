with "config/frontfacebackendservice_config.gpr";
with "uuids";
with "aws";
with "gnatcoll";        -- CONTAINS JSON SUPPORT
with "gnatcoll_sqlite"; -- CONTAINS SQLITE SUPPORT
project Frontfacebackendservice is

   for Source_Dirs use ("src/", "src/db", "src/handlers", "src/proxy", "src/ws", "src/CognitiveLangResp", "config/");
   -- don't forget to include src/db src/handlers src/proxy src/tasks src/ws (submodules)
   for Object_Dir use "obj/" & Frontfacebackendservice_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("frontfacebackendservice.adb");

   SDK_Path := External ("SDK_PATH", "");
   Proving  := External ("PROVING", "False");
   
   package Compiler is
      -- We append ("-gnatp") to the default switches to suppress all checks
      for Default_Switches ("Ada") use Frontfacebackendservice_Config.Ada_Compiler_Switches & ("-gnatp", "-gnatyN", "-gnat2022");
      for Default_Switches ("C") use ("-O2", "-g");
      
      case Proving is
         when "True" =>
            null;
         when others =>
            case SDK_Path is
               when "" =>
                  null;
               when others =>
                  for Default_Switches ("Ada") use Compiler'Default_Switches ("Ada") & ("-isysroot", SDK_Path);
                  for Default_Switches ("C") use Compiler'Default_Switches ("C") & ("-isysroot", SDK_Path);
            end case;
      end case;
   end Compiler;

   package Linker is
      case Proving is
         when "True" =>
            null;
         when others =>
            case SDK_Path is
               when "" =>
                  null;
               when others =>
                  for Default_Switches ("Ada") use ("-L" & SDK_Path & "/usr/lib", "-lSystem");
            end case;
      end case;
   end Linker;

   package Builder is
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Prove is
      for Proof_Switches ("Ada") use
        ("-j0",
         "--mode=flow",
         "--level=1",
         "--warnings=continue",
         "--no-subprojects");
   end Prove;

end Frontfacebackendservice;
