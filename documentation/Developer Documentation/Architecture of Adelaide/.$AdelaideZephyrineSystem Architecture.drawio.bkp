        <mxCell id="fips-files" parent="fips-ref-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" value="&lt;b&gt;Affected Files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;• adl_crypto.c/h — AES-256-GCM, HKDF&lt;br&gt;• adelaide_crypto.ads/adb — FFI wrapper&lt;br&gt;• master_key_store.ads/adb — Key storage&lt;br&gt;• key_derivation.ads/adb — HKDF&lt;br&gt;• system_integrity.ads/adb — Integrity&lt;br&gt;• api_key_manager.ads/adb — Auth&lt;br&gt;• shutdown_manager.ads/adb — Zeroization&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="280" x="10" y="35" as="geometry" />
        </mxCell>
        <mxCell id="fips-rules" parent="fips-ref-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" value="&lt;b&gt;Contributor Rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;1. No new algo without FIPS approval&lt;br&gt;2. Self-tests (KATs) must be maintained&lt;br&gt;3. DRBG changes require review&lt;br&gt;4. Key zeroization mandatory&lt;br&gt;5. Constant-time comparisons&lt;br&gt;6. No plaintext keys outside module&lt;br&gt;7. FIPS mode must be respected&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="280" x="10" y="150" as="geometry" />
        </mxCell>
