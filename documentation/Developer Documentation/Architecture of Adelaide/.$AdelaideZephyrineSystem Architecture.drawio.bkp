  <diagram name="ELP Priority System" id="elp-system-002">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="elp-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;ELP Priority System — The Priority Orchestra 🎵&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #666;&quot;&gt;Deterministic priority arbitration for GPU resource sharing (parallel=1 constraint)&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="700" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="domain-det" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#b85450;" value="&lt;b&gt;DETERMINISTIC DOMAIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Fixed timing, no LLM, pure logic&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="1300" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="domain-spec" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6c8ebf;" value="&lt;b&gt;NON-DETERMINISTIC SPECULATIVE DOMAIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;LLM inference, context fault reasoning, speculative prefetch&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="1300" x="20" y="440" as="geometry" />
        </mxCell>
        <mxCell id="elp3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;ELP3 — Zenith_Orion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;HARDWARE/ACTUATOR CONTROL&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="200" x="20" y="90" as="geometry" />
        </mxCell>
        <mxCell id="elp3-paced" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;Paced_Loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Ada.Real_Time.Clock&lt;br&gt;Start_Time := Clock&lt;br&gt;Execute logic&lt;br&gt;End_Time := Clock&lt;br&gt;Elapsed := End - Start&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="150" x="20" y="150" as="geometry" />
        </mxCell>
        <mxCell id="elp3-padding" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#666666;strokeColor=#d79b00;" value="&lt;b&gt;Dynamic Padding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;if Elapsed &lt; 250µs then&lt;br&gt;  Delay_Time := 250µs - Elapsed&lt;br&gt;  delay until (End + Delay_Time)&lt;br&gt;end if&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="180" x="190" y="150" as="geometry" />
        </mxCell>
        <mxCell id="elp3-wcet" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;WCET Check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;if Elapsed &gt; 250µs then&lt;br&gt;  RAISE Program_Error&lt;br&gt;  &#39;ELP3 WCET DEADLINE MISSED!&#39;&lt;br&gt;end if&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="180" x="390" y="150" as="geometry" />
        </mxCell>
        <mxCell id="elp3-jitter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" value="&lt;b&gt;Jitter Tracking&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Actual_Interval := Now - Start&lt;br&gt;Jitter := |Actual - Target|&lt;br&gt;Update Max_J, Min_J, Sum_J&lt;br&gt;Avg_J := Sum_J / J_Count&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="180" x="590" y="150" as="geometry" />
        </mxCell>
        <mxCell id="elp3-ros2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontColor=#666666;strokeColor=#9673a6;" value="&lt;b&gt;ROS2 Actuator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;ZO_ROS2_Actuator&lt;br&gt;rcl_node_init (DDS network)&lt;br&gt;rcl_publish (servo command)&lt;br&gt;Publish_Actuator_Command&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="180" x="790" y="150" as="geometry" />
        </mxCell>
        <mxCell id="elp3-px4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#666666;strokeColor=#d79b00;" value="&lt;b&gt;PX4 FFI Bindings&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;PX4_FFI_Bindings (Ada/C FFI)&lt;br&gt;Initialize_PX4_Socket (UDP)&lt;br&gt;Send_GNC_Command (R,P,Y,T)&lt;br&gt;MAVLink protocol &lt; 0.25ms&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="200" x="990" y="150" as="geometry" />
        </mxCell>
        <mxCell id="elp3-buffer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" value="&lt;b&gt;ROS2_Command_Buffer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Protected Object (thread-safe)&lt;br&gt;Push_Command from ELP0/ELP1&lt;br&gt;Pop_Command in Paced_Loop&lt;br&gt;Servo_ID + Angle&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="180" x="1210" y="150" as="geometry" />
