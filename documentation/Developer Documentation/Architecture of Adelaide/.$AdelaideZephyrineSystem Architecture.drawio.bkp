        <mxCell id="key-step1" parent="key-deriv-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" value="&lt;b&gt;Step 1: Integrity Hash&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;SHA512(HW_Hash || Binary_Hash)&lt;br&gt;64 bytes (512 bits)&lt;/font&gt;" vertex="1">
