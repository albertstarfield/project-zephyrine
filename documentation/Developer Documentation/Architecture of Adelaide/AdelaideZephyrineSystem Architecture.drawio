        <mxCell id="rc-normalize" parent="branch-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontColor=#666666;strokeColor=#9673a6;" value="&lt;b&gt;Normalize()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Lowercase + collapse whitespace&lt;br&gt;&amp;quot;Say  Hi&amp;quot; → &amp;quot;say hi&amp;quot;&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="140" x="130" y="40" as="geometry" />
