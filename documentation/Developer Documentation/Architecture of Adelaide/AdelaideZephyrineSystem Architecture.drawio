        </mxCell>
        <mxCell id="dal-a-box" parent="1" style="swimlane;startSize=25;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;fontStyle=1;fontSize=12;" value="&lt;b&gt;DAL A — Catastrophic (ECSS Category A)&lt;/b&gt;" vertex="1">
          <mxGeometry height="200" width="900" x="20" y="70" as="geometry" />
        </mxCell>
        <mxCell id="dal-a-scope" parent="dal-a-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;Scope&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• Microcontroller firmware (NO MMU)&lt;br&gt;• Actuator Control&lt;br&gt;• Power Management&lt;br&gt;• Bootloaders&lt;br&gt;• Hard-Limit enforcement logic&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="10" y="35" as="geometry" />
        </mxCell>
        <mxCell id="dal-a-elp" parent="dal-a-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#666666;strokeColor=#d79b00;" value="&lt;b&gt;ELP Levels&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• ELP2: Stella_Icarus (Deterministic)&lt;br&gt;• ELP3: Zenith_Orion (250µs)&lt;br&gt;No LLM — pure logic&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="200" x="210" y="35" as="geometry" />
        </mxCell>
        <mxCell id="dal-a-lang" parent="dal-a-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" value="&lt;b&gt;Permitted Languages&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• Ada (Preferred)&lt;br&gt;• C/C++ (Strict Subset/MISRA)&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="200" x="210" y="125" as="geometry" />
        </mxCell>
        <mxCell id="dal-a-prohibited" parent="dal-a-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;Prohibited&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Python, JavaScript&lt;br&gt;Garbage Collection&lt;br&gt;Dynamic Memory (after init)&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="180" x="430" y="35" as="geometry" />
        </mxCell>
        <mxCell id="dal-a-genai" parent="dal-a-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#666666;strokeColor=#d79b00;" value="&lt;b&gt;GenAI Policy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Allowed but HEAVY SCRUTINY&lt;br&gt;&lt;br&gt;&lt;/font&gt;" vertex="1">
