        <mxCell id="timing-cycle3" value="&lt;font style=&quot;font-size:8px;&quot;&gt;Execute&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" vertex="1" parent="timing-box">
          <mxGeometry x="300" y="30" width="50" height="40" as="geometry" />
