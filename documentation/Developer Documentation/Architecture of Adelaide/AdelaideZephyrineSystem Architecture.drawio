        <mxCell id="key-step2" parent="key-deriv-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontColor=#666666;strokeColor=#6c8ebf;" value="&lt;b&gt;Step 2: Master Key&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;HKDF-SHA512&lt;br&gt;salt = integrity_hash&lt;br&gt;ikm = user_secret (password/recovery key)&lt;br&gt;info = &amp;quot;adelaide:master-key:v1&amp;quot;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="190" y="35" as="geometry" />
        </mxCell>
