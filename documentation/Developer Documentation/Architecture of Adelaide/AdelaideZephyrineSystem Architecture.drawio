        <!-- Flow Diagram -->
        <mxCell id="ax-flow" parent="1" style="swimlane;startSize=25;fillColor=#ffe6cc;fontColor=#666666;strokeColor=#d79b00;fontStyle=1;fontSize=12;" value="&lt;b&gt;AxiomAether Pipeline Flow — The Derivation Engine ⚗️&lt;/b&gt;" vertex="1">
          <mxGeometry height="400" width="1760" x="20" y="430" as="geometry" />
        </mxCell>
        <!-- Trigger -->
        <mxCell id="ax-trigger" parent="ax-flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontColor=#666666;strokeColor=#6c8ebf;" value="&lt;b&gt;Model Output: [AXIOM_DERIVE]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[AXIOM_DERIVE: statement=&quot;...&quot;]&lt;br&gt;Injected via Whimsical_Adelaide system prompt&lt;br&gt;Model decides when social facts are suspect&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="20" y="40" as="geometry" />
        </mxCell>
        <!-- Parse Statement -->
        <mxCell id="ax-parse" parent="ax-flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#666666;strokeColor=#666;" value="&lt;b&gt;Parse Statement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Extract from [AXIOM_DERIVE: statement=&quot;...&quot;]&lt;br&gt;Statement := raw text to derive&lt;br&gt;Initialize Axiom_JMP := 1&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="200" x="270" y="40" as="geometry" />
        </mxCell>
        <!-- Internal State -->
        <mxCell id="ax-state" parent="ax-flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontColor=#666666;strokeColor=#9673a6;" value="&lt;b&gt;Initialize Internal_State&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Internal_State := &quot;Current Data: &quot; + existing state&lt;br&gt;Append &quot;[AXIOM_ORIGINATION]: &quot; + Statement&lt;br&gt;This is the axiomatic seed&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="500" y="40" as="geometry" />
        </mxCell>
        <!-- AxiomAether Loop -->
        <mxCell id="ax-loop-box" parent="ax-flow" style="swimlane;startSize=20;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;fontStyle=1;fontSize=10;" value="&lt;b&gt;AxiomAether Loop (Max 99 iterations)&lt;/b&gt;" vertex="1">
          <mxGeometry height="280" width="1000" x="20" y="100" as="geometry" />
        </mxCell>
        <!-- Loop: Generate -->
        <mxCell id="ax-gen" parent="ax-loop-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#666666;strokeColor=#666;" value="&lt;b&gt;Generate Axiom Prompt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Wrap_ChatML(Axiom_Sys, &quot;Current Data: &quot; + Internal_State)&lt;br&gt;Snowball_Enaga_Orchestrator model&lt;br&gt;Generate with FreeParallelMemory=True&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="250" x="20" y="30" as="geometry" />
        </mxCell>
        <!-- Loop: Parse Step -->
        <mxCell id="ax-step" parent="ax-loop-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" value="&lt;b&gt;Parse Axiom Step&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Axiom_Step := Trim(Response)&lt;br&gt;Log: &quot;[AxiomAether] JMP&quot; + JMP + &quot;: &quot; + Step&lt;br&gt;Push to stream if not External_Agent&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="290" y="30" as="geometry" />
        </mxCell>
        <!-- Loop: Remember -->
        <mxCell id="ax-rem" parent="ax-loop-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" value="&lt;b&gt;Remember Step&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Database_Manager.Remember&lt;br&gt;(Prompt, Response, &quot;&quot;)&lt;br&gt;Persist derivation history&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="180" x="530" y="35" as="geometry" />
        </mxCell>
        <!-- Decision Diamond -->
        <mxCell id="ax-decide" parent="ax-loop-box" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" value="&lt;b&gt;Parse Action?&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="120" x="730" y="30" as="geometry" />
        </mxCell>
        <!-- ACTION branch -->
        <mxCell id="ax-action" parent="ax-loop-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontColor=#666666;strokeColor=#9673a6;" value="&lt;b&gt;Tool Execution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[ACTION: ToolName(params)]&lt;br&gt;Tool_Manager.Execute_Tool&lt;br&gt;Append result to Internal_State&lt;br&gt;⚠️ AXIOM_DERIVE blocked (self-spawn)&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="20" y="130" as="geometry" />
        </mxCell>
        <!-- FINISH branch -->
        <mxCell id="ax-finish" parent="ax-loop-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" value="&lt;b&gt;Derivation Complete&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[FINISH] or result detected&lt;br&gt;Append [AXIOM_DERIVATION_RESULT]&lt;br&gt;Exit loop&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="180" x="260" y="135" as="geometry" />
        </mxCell>
        <!-- Loop counter -->
        <mxCell id="ax-counter" parent="ax-loop-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;Increment &amp;amp; Check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Axiom_JMP := Axiom_JMP + 1&lt;br&gt;exit when Axiom_JMP &amp;gt; 99&lt;/br&gt;Persist Internal_State to DB&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="180" x="460" y="135" as="geometry" />
        </mxCell>
