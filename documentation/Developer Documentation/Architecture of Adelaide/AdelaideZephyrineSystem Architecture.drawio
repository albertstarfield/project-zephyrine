        <mxCell id="c-ffi-box" value="&lt;b&gt;Ada/C FFI Bridge&lt;/b&gt;" style="swimlane;startSize=20;fillColor=#e1d5e7;fontColor=#666666;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
