          <mxGeometry x="210" y="80" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Context Fault Detection -->
        <mxCell id="cf-detect" value="&lt;b&gt;Parse Response&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Check for [CONTEXT_FAULT:&lt;br&gt;query=X category=Y]&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="160" height="80" as="geometry" />
        </mxCell>

