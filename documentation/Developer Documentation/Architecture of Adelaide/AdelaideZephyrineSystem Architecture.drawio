  <diagram name="ELP Priority System" id="elp-system-002">
    <mxGraphModel dx="2400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="elp-title" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;ELP Priority System — Execution Level Priority&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #666;&quot;&gt;Deterministic priority arbitration for GPU resource sharing (parallel=1 constraint)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="700" height="50" as="geometry" />
        </mxCell>

        <!-- Domain Labels -->
        <mxCell id="domain-det" value="&lt;b&gt;DETERMINISTIC DOMAIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Fixed timing, no LLM, pure logic&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="1300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="domain-spec" value="&lt;b&gt;NON-DETERMINISTIC SPECULATIVE DOMAIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;LLM inference, context fault reasoning, speculative prefetch&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="440" width="1300" height="30" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- ELP3: Zenith_Orion — Expanded Horizontal Detail -->
        <!-- ============================================================ -->
        <mxCell id="elp3" value="&lt;b&gt;ELP3 — Zenith_Orion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;HARDWARE/ACTUATOR CONTROL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- ELP3 Paced Loop -->
        <mxCell id="elp3-paced" value="&lt;b&gt;Paced_Loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Ada.Real_Time.Clock&lt;br&gt;Start_Time := Clock&lt;br&gt;Execute logic&lt;br&gt;End_Time := Clock&lt;br&gt;Elapsed := End - Start&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="150" width="150" height="100" as="geometry" />
        </mxCell>

        <!-- ELP3 Padding Logic -->
        <mxCell id="elp3-padding" value="&lt;b&gt;Dynamic Padding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;if Elapsed &lt; 250µs then&lt;br&gt;  Delay_Time := 250µs - Elapsed&lt;br&gt;  delay until (End + Delay_Time)&lt;br&gt;end if&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#666666;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="190" y="150" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- ELP3 WCET Check -->
        <mxCell id="elp3-wcet" value="&lt;b&gt;WCET Check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;if Elapsed &gt; 250µs then&lt;br&gt;  RAISE Program_Error&lt;br&gt;  'ELP3 WCET DEADLINE MISSED!'&lt;br&gt;end if&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="390" y="150" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- ELP3 Jitter Tracking -->
        <mxCell id="elp3-jitter" value="&lt;b&gt;Jitter Tracking&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Actual_Interval := Now - Start&lt;br&gt;Jitter := |Actual - Target|&lt;br&gt;Update Max_J, Min_J, Sum_J&lt;br&gt;Avg_J := Sum_J / J_Count&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="590" y="150" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- ELP3 ROS2 Actuator -->
        <mxCell id="elp3-ros2" value="&lt;b&gt;ROS2 Actuator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;ZO_ROS2_Actuator&lt;br&gt;rcl_node_init (DDS network)&lt;br&gt;rcl_publish (servo command)&lt;br&gt;Publish_Actuator_Command&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontColor=#666666;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="790" y="150" width="180" height="100" as="geometry" />
