        <!-- PINN Loss Detail -->
        <mxCell id="pinn-loss" parent="pinn-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" value="&lt;b&gt;PINN Loss Function&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;Loss = MSE_data + λ||iℏ∂Ψ/∂t − (−ℏ²/2m∇²+V)Ψ||²&lt;br&gt;Hard-codes PDE into loss. No grid solver needed.&lt;br&gt;DeepXDE: dde.icbc.DirichletBC for Bridge targets&lt;/font&gt;" vertex="1">
