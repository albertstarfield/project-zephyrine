        <mxCell id="sc-entry" parent="spec-cache-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" value="&lt;b&gt;Cache_Entry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Predicted_Query&lt;br&gt;Cached_Answer&lt;br&gt;Timestamp + Valid&lt;/font&gt;" vertex="1">
