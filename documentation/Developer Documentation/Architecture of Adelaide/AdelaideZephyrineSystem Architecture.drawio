        <mxCell id="ax-context" parent="ax-theory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontColor=#666666;strokeColor=#9673a6;" value="&lt;b&gt;Context Fault Resolution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Packer2023MemGPT, Information2026ContextFault&lt;br&gt;OS-level context faults → semantic spaces&lt;br&gt;Resolves truncation problem&lt;br&gt;Maps to hierarchical memory&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="200" x="900" y="35" as="geometry" />
        </mxCell>
        <mxCell id="ax-temporal" parent="ax-theory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#666666;strokeColor=#666;" value="&lt;b&gt;Temporal Constraints&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;doherty1982economic&lt;br&gt;Mark2023Attention, Microsoft2015Attention&lt;br&gt;Doherty Threshold for response time&lt;br&gt;Human attention decay modeling&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="200" x="1120" y="35" as="geometry" />
        </mxCell>
        <mxCell id="ax-ethical" parent="ax-theory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" value="&lt;b&gt;Ethical Framework&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;IEEE2021EthicalAI&lt;br&gt;AI2026MoralSpaceAgents&lt;br&gt;Autonomous bias mitigation&lt;br&gt;Moral drift constraints for deep space&lt;/font&gt;" vertex="1">
