        <mxCell id="ax-output" parent="ax-flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" value="&lt;b&gt;Derivation Result&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Axiom_Step contains final truth&lt;br&gt;Appended to Internal_State&lt;br&gt;Available for next reasoning hop&lt;br&gt;Model uses result instead of social consensus&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="250" x="20" y="300" as="geometry" />
