        <mxCell id="ax-papers" parent="1" style="swimlane;startSize=25;fillColor=#dae8fc;fontColor=#666666;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" value="&lt;b&gt;Key Papers &amp;amp; Citations — The Literature Behind the Logic 📚&lt;/b&gt;" vertex="1">
