        <mxCell id="sc-elp0" parent="spec-cache-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontColor=#666666;strokeColor=#9673a6;" value="&lt;b&gt;ELP0 Background Task&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Proactive_Cache_Task&lt;br&gt;Predicts follow-up queries&lt;br&gt;Populates cache proactively&lt;/font&gt;" vertex="1">
