        <mxCell id="ax-dmn" parent="ax-theory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;DMN Dysconnectivity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;decoding2021schizophrenia&lt;br default=&quot;false&quot;/&gt;Default Mode Network metrics&lt;br&gt;Detecting AI hallucinations&lt;br&gt;Semantic deviation baseline&lt;/font&gt;" vertex="1">
