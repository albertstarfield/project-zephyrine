        </mxCell>
        <mxCell id="dal-a-failure" parent="dal-a-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;Failure Consequence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Hardware damage&lt;br&gt;Thermal runaway&lt;br&gt;Total system loss&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="180" x="430" y="115" as="geometry" />
        </mxCell>
        <mxCell id="dal-a-verify" parent="dal-a-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" value="&lt;b&gt;Verification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Manual timing analysis&lt;br&gt;&quot;Loop &amp;lt; 250µs&quot; required determenistic&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="180" x="630" y="115" as="geometry" />
        </mxCell>
        <mxCell id="dal-b-box" parent="1" style="swimlane;startSize=25;fillColor=#ffe6cc;fontColor=#666666;strokeColor=#d79b00;fontStyle=1;fontSize=12;" value="&lt;b&gt;DAL B — Hazardous (ECSS Category B)&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="900" x="20" y="290" as="geometry" />
        </mxCell>
        <mxCell id="dal-b-scope" parent="dal-b-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#666666;strokeColor=#d79b00;" value="&lt;b&gt;Scope&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• Daemon Manager&lt;br&gt;• IPC Bridges&lt;br&gt;• System Health Monitors&lt;br&gt;• Shared Memory (SHM) Scoreboards&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="180" x="10" y="35" as="geometry" />
        </mxCell>
        <mxCell id="dal-b-role" parent="dal-b-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" value="&lt;b&gt;Role&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Protects system FROM the AI&lt;br&gt;Monitors heartbeat of DAL C&lt;br&gt;Kill/Restart if AI hangs or&lt;br&gt;hallucinates unsafe values&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="200" x="210" y="35" as="geometry" />
