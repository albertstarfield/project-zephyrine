        <mxCell id="timing-label1" value="250µs" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;" vertex="1" parent="timing-box">
          <mxGeometry x="10" y="75" width="60" height="20" as="geometry" />
