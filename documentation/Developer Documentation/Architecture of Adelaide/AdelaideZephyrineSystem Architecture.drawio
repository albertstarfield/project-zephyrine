          <mxGeometry height="60" width="130" x="290" y="40" as="geometry" />
        </mxCell>
        <mxCell id="rc-decision" parent="branch-box" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" value="&lt;b&gt;Hit?&lt;/b&gt;" vertex="1">
