        </mxCell>

        <mxCell id="timing-label3" value="250µs" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;" vertex="1" parent="timing-box">
          <mxGeometry x="300" y="75" width="60" height="20" as="geometry" />
        </mxCell>

        <!-- Timing arrows -->
        <mxCell id="e-t1" style="endArrow=classic;html=1;strokeWidth=1;strokeColor=#666;" edge="1" parent="timing-box">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="10" y="100" as="sourcePoint" />
            <mxPoint x="360" y="100" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Industry benchmarks -->
        <mxCell id="benchmarks" value="&lt;b&gt;Industry Benchmarks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;&quot;&gt;• Boston Dynamics Spot/Atlas: 500-1000 Hz (1-2ms)&lt;br&gt;• Betaflight Drone FC: 1000-4000 Hz (0.25-1ms)&lt;br&gt;• KUKA/UR Robots: 250-500 Hz (2-4ms)&lt;br&gt;• Adelaide ELP3: 4000 Hz (250µs) — matches drone FC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" vertex="1" parent="timing-box">
          <mxGeometry x="10" y="115" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
