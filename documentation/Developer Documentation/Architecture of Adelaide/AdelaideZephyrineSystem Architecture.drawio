        <!-- ============================================================ -->
        <!-- ELP1: Hybrid_Generate -->
        <!-- ============================================================ -->
        <mxCell id="elp1" value="&lt;b&gt;ELP1 — Hybrid_Generate (User-Facing)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;LLM INFERENCE + REASONING&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• Main user request processing&lt;br&gt;• Snowball-Enaga model inference&lt;br&gt;• Context Fault multi-hop reasoning&lt;br&gt;• Tool execution (search, imagine, etc.)&lt;br&gt;• Memory injection + Reranker&lt;br&gt;• Streaming response delivery&lt;br&gt;• Unlimited retry budget (20 max)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontColor=#666666;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="480" width="350" height="170" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
