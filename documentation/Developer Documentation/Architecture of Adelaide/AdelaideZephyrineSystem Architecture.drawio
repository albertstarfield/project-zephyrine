        <mxCell id="spec-cache-box" parent="1" style="swimlane;startSize=25;fillColor=#e1d5e7;fontColor=#666666;strokeColor=#9673a6;fontStyle=1;fontSize=12;" value="&lt;b&gt;Speculative Proactive Prediction Cache — Jaccard Similarity 🔮&lt;/b&gt;" vertex="1">
