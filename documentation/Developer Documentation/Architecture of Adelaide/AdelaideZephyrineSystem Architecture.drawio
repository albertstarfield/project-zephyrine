        <mxCell id="branch-box" parent="1" style="swimlane;startSize=25;fillColor=#dae8fc;fontColor=#666666;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" value="&lt;b&gt;Branch Prediction — Response Cache (O(1) Instant Bypass) 🎯&lt;/b&gt;" vertex="1">
          <mxGeometry height="160" width="960" x="20" y="70" as="geometry" />
        </mxCell>
        <mxCell id="rc-input" parent="branch-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontColor=#666666;strokeColor=#6c8ebf;" value="&lt;b&gt;User Prompt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Raw input string&lt;br&gt;e.g. &amp;quot;Hello!&amp;quot;&lt;/font&gt;" vertex="1">
