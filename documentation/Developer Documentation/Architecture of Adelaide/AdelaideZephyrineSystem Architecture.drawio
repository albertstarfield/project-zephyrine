        <mxCell id="ax-g1" parent="ax-protect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;No Self-Spawn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;AXIOM_DERIVE cannot invoke itself&lt;br&gt;Prevents infinite recursion&lt;br&gt;Returns: &quot;ERROR: AxiomAether cannot spawn itself.&quot;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="250" x="20" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ax-g2" parent="ax-protect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;Iteration Limit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Max 99 iterations per derivation&lt;br&gt;exit when Axiom_JMP &amp;gt; 99&lt;br&gt;Prevents runaway computation&lt;/font&gt;" vertex="1">
