        <!-- Self-Spawn Protection -->
        <mxCell id="ax-protect" parent="1" style="swimlane;startSize=25;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;fontStyle=1;fontSize=12;" value="&lt;b&gt;Safety Constraints — The Guardrails 🛡️&lt;/b&gt;" vertex="1">
          <mxGeometry height="120" width="1760" x="20" y="1070" as="geometry" />
