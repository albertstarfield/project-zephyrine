        <mxCell id="cf-title" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Context Fault System — Multi-Hop Reasoning&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #666;&quot;&gt;Imported from Python &quot;Multi Level Condensed Memory Contextual Fetching (MLCMCF)&quot; — Zephy Architecture&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="800" height="50" as="geometry" />
