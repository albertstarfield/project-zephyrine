        <mxCell id="sc-store" parent="spec-cache-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" value="&lt;b&gt;Store(Predicted, Answer)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Max 5 entries&lt;br&gt;LRU eviction&lt;br&gt;Protected object (thread-safe)&lt;/font&gt;" vertex="1">
