        </mxCell>
        <mxCell id="ax-p2" parent="ax-papers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#666666;strokeColor=#666;" value="&lt;b&gt;[2] Piaget1952Origins&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;J. Piaget, &quot;The Origins of Intelligence in Children,&quot;&lt;br&gt;International Universities Press, 1952.&lt;br&gt;Foundation: Constructivism — knowledge construction&lt;/font&gt;" vertex="1">
