        <mxCell id="cf-no-fault" value="&lt;b&gt;Response Complete&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;No context fault detected&lt;br&gt;Return to client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="70" width="160" height="60" as="geometry" />
