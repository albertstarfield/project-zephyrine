        <mxCell id="e-cffi-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#9673a6;" edge="1" source="c-ffi-c" target="c-ffi-dds" parent="c-ffi-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Constraint note -->
        <mxCell id="constraint-note" value="&lt;b&gt;PARALLEL=1 CONSTRAINT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Only ONE model can be loaded in GPU at any time.&lt;br&gt;ELP3/ELP2 are deterministic (no GPU).&lt;br&gt;ELP1 and ELP0 share GPU — ELP0 is preempted on ELP1 arrival.&lt;br&gt;Violation = Metal OOM = server crash.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fff2cc;fontColor=#666666;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1200" y="480" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- Timing info -->
        <mxCell id="timing-info" value="&lt;b&gt;Timing Requirements&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• ELP3 WCET: Fixed 250µs (4000 Hz)&lt;br&gt;• ELP2 WCET: &lt;1ms (deterministic)&lt;br&gt;• ELP1 TTFB: &lt;10ms (streaming)&lt;br&gt;• ELP0: background, preemptible&lt;br&gt;• Watchdog timeout: 600s (10 min)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1200" y="600" width="250" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
