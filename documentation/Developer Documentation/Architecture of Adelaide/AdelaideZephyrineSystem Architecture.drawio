        <mxCell id="pinn-deepxde" parent="pinn-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontColor=#666666;strokeColor=#6c8ebf;" value="&lt;b&gt;PINN (DeepXDE)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Loss = MSE_data + λ||PDE_residual||²&lt;br&gt;Solves PDE without grid solvers&lt;br&gt;Outputs: Ψ(x,t) wavefunction&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="200" x="260" y="40" as="geometry" />
