        <mxCell id="encrypt-fn" parent="aes-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" value="&lt;b&gt;Encrypt_Field&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;AES-256-GCM&lt;br&gt;sub_key_hex + plaintext&lt;br&gt;→ hex-encoded ciphertext&lt;/font&gt;" vertex="1">
