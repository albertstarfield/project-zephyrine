        <mxCell id="pinn-schrodinger" parent="pinn-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontColor=#666666;strokeColor=#9673a6;" value="&lt;b&gt;Schrödinger Equation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;iℏ ∂Ψ/∂t = −(ℏ²/2m)∇²Ψ + V(x)Ψ&lt;br&gt;Nonlinear Schrödinger / Gross-Pitaevskii&lt;br&gt;Boundary: Schrödinger Bridge target&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="200" x="10" y="40" as="geometry" />
