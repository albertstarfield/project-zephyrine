          <mxGeometry height="80" width="210" x="670" y="35" as="geometry" />
        </mxCell>
        <mxCell id="hw-partial-key" parent="key-deriv-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;Partial Key (Hardware)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;TPM2 / SecureEnclave / HSM&lt;br&gt;Stores partial key shard&lt;br&gt;Unseal on boot only&lt;br&gt;Attestation required&lt;/font&gt;" vertex="1">
