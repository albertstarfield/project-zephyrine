        <mxCell id="c-ffi-c" value="&lt;font style=&quot;font-size:9px;&quot;&gt;C Bindings&lt;br&gt;rcl_init&lt;br&gt;rcl_node_init&lt;br&gt;rcl_publish&lt;br&gt;rcl_take&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#666666;strokeColor=#666;" vertex="1" parent="c-ffi-box">
          <mxGeometry x="130" y="25" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c-ffi-dds" value="&lt;font style=&quot;font-size:9px;&quot;&gt;DDS Network&lt;br&gt;ROS2 Middleware&lt;br&gt;FastDDS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#666666;strokeColor=#82b366;" vertex="1" parent="c-ffi-box">
