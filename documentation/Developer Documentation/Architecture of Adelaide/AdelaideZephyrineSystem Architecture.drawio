        </mxCell>
        <mxCell id="ax-g4" parent="ax-protect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;External Agent Bypass&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;If External_Agent=True, skip stream push&lt;br&gt;Internal derivations only&lt;br&gt;Prevents external manipulation&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="250" x="830" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ax-g5" parent="ax-protect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#666666;strokeColor=#b85450;" value="&lt;b&gt;State Persistence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Internal_State saved to DB after each hop&lt;br&gt;System_State = &quot;Internal_State&quot;&lt;br&gt;Survives restart/shutdown&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="250" x="1100" y="30" as="geometry" />
