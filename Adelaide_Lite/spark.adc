pragma Profile (Ravenscar);
pragma SPARK_Mode (On);
pragma Restrictions (No_Exception_Propagation);
pragma Restrictions (No_Elaboration_Code);
pragma Restrictions (No_Use_Of_Pragma (Import, Function, Procedure, Package, Object, All));
pragma Restrictions (Max_Task_Entries = 10);
pragma Restrictions (Max_Protected_Entries = 10);
pragma Restrictions (Max_Storage_Pools = 1);
pragma Restrictions (No_Dynamic_Attachment);
pragma Restrictions (No_Dynamic_Allocation);
pragma Restrictions (No_Use_Of_Current_Task);
pragma Restrictions (No_Use_Of_Secondary_Stack);
pragma Restrictions (No_Use_Of_Floating_Point);