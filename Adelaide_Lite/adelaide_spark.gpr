project Adelaide_Spark is
   for Source_Dirs use ("src");
   for Source_Files use ("math_utils.ads", "math_utils.adb", "integrity_utils.ads", "integrity_utils.adb");
   for Object_Dir use "obj/spark";
   
   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata", "-gnato", "-gnatwa");
   end Compiler;
end Adelaide_Spark;
