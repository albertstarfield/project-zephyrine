project Adelaide_Spark is
   for Source_Dirs use ("src");
   for Source_Files use ("math_utils.ads", "math_utils.adb", "integrity_utils.ads", "integrity_utils.adb", "watchdog_manager.ads", "watchdog_manager.adb");
   for Object_Dir use "obj/spark";
   
   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata", "-gnato", "-gnatwa");
   end Compiler;
end Adelaide_Spark;
