project Adelaide_Spark is
   for Source_Dirs use ("src", "ZenithOrion/src");
   for Source_Files use ("math_utils.ads", "math_utils.adb",
                         "integrity_utils.ads", "integrity_utils.adb",
                         "model_types.ads",
                         "fuzzy_match.ads", "fuzzy_match.adb",
                         "watchdog_manager.ads");
   for Object_Dir use "obj/spark";
   
package Builder is
   for Global_Configuration_Pragmas use "gnat_spark.adc";
   for Switches ("gnatprove") use ("--prove=auto");
end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnata", "-gnato", "-gnatwa");
   end Compiler;
end Adelaide_Spark;
