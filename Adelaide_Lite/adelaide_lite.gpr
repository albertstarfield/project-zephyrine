with "config/adelaide_lite_config.gpr";
with "aws";
with "gnatcoll";
with "ada_sqlite3";
project Adelaide_Lite is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Adelaide_Lite_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adelaide_lite.adb", "adelaide_server.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Adelaide_Lite_Config.Ada_Compiler_Switches & ("-gnat2012");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--report=fail", "--warnings=off");
   end Prove;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use (
         "-Wl,-syslibroot,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk",
         Project'Project_Dir & "obj/development/scheduling.o",
         "-L" & Project'Project_Dir & "../llama.cpp/build/src", "-lllama",
         "-L" & Project'Project_Dir & "../llama.cpp/build/ggml/src", "-lggml", "-lggml-base", "-lggml-cpu",
         "-L" & Project'Project_Dir & "../llama.cpp/build/ggml/src/ggml-metal", "-lggml-metal",
         "-L" & Project'Project_Dir & "../llama.cpp/build/ggml/src/ggml-blas", "-lggml-blas",
         "-framework", "Accelerate",
         "-framework", "Metal",
         "-framework", "Foundation",
         "-lsqlite3",
         "-lc++"
      );
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Adelaide_Lite;
