with "config/adelaide_lite_config.gpr";
with "aws";
with "gnatcoll";
with "ada_sqlite3";
project Adelaide_Lite is

   for Languages use ("Ada");
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Adelaide_Lite_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adelaide_lite.adb", "adelaide_server.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Adelaide_Lite_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnatX", "-mmacosx-version-min=15.0");
   end Compiler;

   package Linker is
      for Switches ("Ada") use (
         "-L/Users/albertstarfield/LibraryTube/OpenIntellegentiaPlatform/llama.cpp/build/src",
         "-lllama",
         "-L/Users/albertstarfield/LibraryTube/OpenIntellegentiaPlatform/llama.cpp/build/ggml/src",
         "-lggml",
         "-lggml-base",
         "-lggml-cpu",
         "-L/Users/albertstarfield/LibraryTube/OpenIntellegentiaPlatform/llama.cpp/build/ggml/src/ggml-metal",
         "-lggml-metal",
         "-L/Users/albertstarfield/LibraryTube/OpenIntellegentiaPlatform/llama.cpp/build/ggml/src/ggml-blas",
         "-lggml-blas",
         "-L/opt/homebrew/opt/sqlite/lib",
         "-lsqlite3",
         "-mmacosx-version-min=15.0",
         "-framework", "Accelerate",
         "-framework", "Metal",
         "-framework", "Foundation",
         "-lc++"
      );
   end Linker;

end Adelaide_Lite;
