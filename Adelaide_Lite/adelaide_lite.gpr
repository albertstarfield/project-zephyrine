with "config/adelaide_lite_config.gpr";
with "aws";
with "gnatcoll";
project Adelaide_Lite is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Adelaide_Lite_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adelaide_lite.adb", "adelaide_server.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Adelaide_Lite_Config.Ada_Compiler_Switches & ("-gnat2012");
   end Compiler;

   package Prove is
      for Switches use ("--level=2", "--report=fail", "--warnings=off");
   end Prove;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use (
         "-Wl,-syslibroot,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk",
         Project'Project_Dir & "obj/development/scheduling.o"
      );
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Adelaide_Lite;
