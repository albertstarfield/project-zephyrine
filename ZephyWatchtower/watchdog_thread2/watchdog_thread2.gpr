project Watchdog_Thread2 is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/development";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("watchdog_thread2.adb", "child_process.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-gnat2012", "-gnatwa",
         "-gnata");  --  Enable assertions (Pre/Post contracts at runtime)
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   --  SPARK Prove configuration.
   --  Used by: gnatprove --mode=flow (data/flow analysis)
   --
   --  --mode=flow:     Flow analysis only. Safe for this codebase because:
   --                   C_Bridge body and Perform_Memory_Check are SPARK_Mode => Off
   --                   (C FFI + pointer arithmetic). Flow mode does NOT attempt
   --                   to prove C-interop bodies; it skips them cleanly.
   --  --level=1:       Fast analysis. Escalate to 4 for exhaustive proof in CI.
   --  --no-subprojects: Do not recurse into Alire dependency projects.
   --  --warnings=continue: Log SPARK warnings without aborting.
   package Prove is
      for Proof_Switches ("Ada") use
        ("-j0",
         "--mode=flow",
         "--level=1",
         "--warnings=continue",
         "--no-subprojects");
   end Prove;

end Watchdog_Thread2;
